# ==============================================================================
# FantaJESic - Configurazione Variabili d'Ambiente (Render & Locale)
# ==============================================================================

# MongoDB Atlas Connection String (Obbligatoria per persistenza reale)
# Esempio: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/fantajesic?retryWrites=true&w=majority
MONGODB_URI=""

# Segreto JWT per firmare i token di sessione (Usa una stringa casuale lunga in produzione)
JWT_SECRET="cambia-questo-segreto-con-una-stringa-casuale-sicura"

# Cloudinary Credentials (Obbligatorie per upload reale foto e video)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Porta del server (Render la inietta automaticamente; in locale/AI Studio default 3000)
PORT=3000

# URL pubblico dell'applicazione
APP_URL="http://localhost:3000"
